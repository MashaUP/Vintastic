{
  "name": "vintastic",
  "version": "2.2.1",
  "private": true,
  "description": "Vintastic — estensione browser per Vinted (Manifest V3). Nessuna dipendenza a runtime: npm serve solo per test e pacchetto.",
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "node scripts/check.mjs && eslint . --max-warnings 0 && node --test tests/unit/*.test.mjs",
    "test:e2e": "python3 tests/e2e/run_all.py",
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs --github"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.15.0"
  },
  "license": "MIT"
}
